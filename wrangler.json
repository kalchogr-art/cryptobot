    {
      "$schema": "node_modules/wrangler/config-schema.json",
      "name": "cryptobot",
      "main": "src/index.ts",
      "compatibility_date": "2026-09-15",
      "workers_dev": true,
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cryptobot-db",
